# Firebase — local placeholders only.
# Copy to `.env` on this machine. NEVER commit real values.
#
# Public client config (google-services.json / GoogleService-Info.plist)
# is NOT the same as a service-account private key.
# Put service-account JSON in this folder locally. Never commit it.

FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_ANDROID_APP_ID=YOUR_FIREBASE_ANDROID_APP_ID
FIREBASE_IOS_APP_ID=YOUR_FIREBASE_IOS_APP_ID
FIREBASE_SERVICE_ACCOUNT_PATH=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_PATH
