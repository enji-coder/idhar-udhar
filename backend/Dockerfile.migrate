# One-off migration image. Build from the repository root:
#   docker build -f backend/Dockerfile.migrate -t idhar-udhar-migrate .
# Do not use this image for the API service.
# SQL lands at /app/records_database/migrations, the runner default and the
# path in docs/ecs_staging_migrate.taskdef.template.json.
FROM node:20-alpine

WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

COPY backend/scripts/migrate.mjs ./scripts/migrate.mjs
COPY backend/rds-global-bundle.pem /app/certs/rds-global-bundle.pem
COPY records_database/migrations ./records_database/migrations

# Refuse an image whose pinned migration bytes differ from production.
# Windows CRLF checkouts must not be copied in unchanged.
RUN node --input-type=module -e "import { readFileSync } from 'node:fs'; import { PRODUCTION_FILE_CHECKSUMS, sha256Hex } from './scripts/migrate.mjs'; for (const [version, expected] of Object.entries(PRODUCTION_FILE_CHECKSUMS)) { const actual = sha256Hex(readFileSync('/app/records_database/migrations/' + version + '.sql')); if (actual !== expected) { process.stderr.write('Pinned migration checksum mismatch: ' + version + '\n'); process.exit(1); } }"

ENV NODE_ENV=production
ENV MIGRATIONS_DIR=/app/records_database/migrations
ENV DATABASE_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem

CMD ["node", "scripts/migrate.mjs"]
