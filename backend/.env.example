# IDHAR UDHAR API — local placeholders only.
# Copy to backend/.env. NEVER commit real values.
# DATABASE_* may instead be loaded from records_database/.env
# Backend loads these files itself (not dotenv). Unquoted `#` inside values is kept.
# Existing process.env wins; then backend/.env; then records_database/.env.

NODE_ENV=development
PORT=3000

# PostgreSQL (existing local database — do not recreate)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=idhar_udhar
DATABASE_USER=idhar_admin
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Access JWT (min 32 characters). Not a Flutter secret.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=idhar-udhar-api

# Refresh tokens are hashed into public.sessions.refresh_token_hash
REFRESH_TOKEN_PEPPER=
JWT_REFRESH_TTL_SECONDS=2592000

# OTP (length/TTL/attempts are DEVELOPMENT DEFAULTS — not locked business rules)
# Cooldown 30s is an architecture lock.
OTP_HASH_PEPPER=
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=20
# capture = in-memory for local/tests. unconfigured = store challenge, do not send SMS.
# msg91 = MSG91 SendOTP. Requires MSG91_AUTHKEY, MSG91_TEMPLATE_ID, MSG91_SENDER_ID.
# Capture is ignored when NODE_ENV=production (forced unconfigured).
# msg91 is allowed in production when those credentials are set (no silent fallback).
# Non-production capture accepts any exactly-4-digit OTP after a real request.
OTP_DELIVERY_PROVIDER=capture
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_TIMEOUT_MS=10000
# DEVELOPMENT ONLY. Allows GET /v1/auth/dev/otp-capture from loopback so Chrome
# and local emulators can complete OTP. Ignored when NODE_ENV=production.
# Set false to disable peek even in development.
DEV_OTP_PEEK=true

# Notification worker (retry ceiling is a DEVELOPMENT DEFAULT — not a locked business rule)
# capture = in-memory sink for local/tests. unconfigured = do not pretend a push was delivered.
# fcm = Firebase Admin SDK (HTTP v1). Requires FIREBASE_SERVICE_ACCOUNT_JSON injected
# from AWS Secrets Manager (existing secret key). Do not commit the JSON.
# Capture is ignored when NODE_ENV=production (forced unconfigured).
# fcm is allowed in production when the JSON is set (no silent fallback).
PUSH_PROVIDER=capture
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=2

# Routing. mock = deterministic local provider (default outside production).
# Production with ROUTING_PROVIDER unset selects google and requires GOOGLE_MAPS_API_KEY
# from ECS/Secrets Manager. google never falls back to mock. Do not commit real keys.
ROUTING_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
ROUTING_TIMEOUT_MS=10000

# Online payments. The only implemented adapter is unconfigured (intent-only;
# never marks ONLINE PAID; never calls a gateway). Unknown values fail startup.
# Do not set Razorpay/Cashfree/Stripe keys — those adapters do not exist.
PAYMENT_PROVIDER=unconfigured

# Rider last-known location. memory = local process map. redis = Valkey/ElastiCache.
# Production with LOCATION_STORE unset selects redis and requires REDIS_ENABLED=true
# plus REDIS_HOST. redis never falls back to memory.
LOCATION_STORE=memory
# Redis / Valkey. Local default is disabled so the API runs without a cache node.
# Production: REDIS_ENABLED=true, REDIS_TLS=true, LOCATION_STORE=redis, REDIS_HOST from ECS/Secrets.
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_TLS=false

# Private rider KYC / POD object storage. Bytes go to S3; metadata stays in PostgreSQL.
# Empty bucket = storage unconfigured (local/API starts; uploads fail honestly).
# Production: S3_DOCUMENTS_BUCKET=idhar-udhar-prod-documents and AWS_REGION=ap-south-1.
# Uses the ECS task role / default AWS credential chain. Do not set AWS access keys.
S3_DOCUMENTS_BUCKET=
AWS_REGION=
S3_SIGNED_URL_TTL_SECONDS=300

# Fare quote TTL is a DEVELOPMENT DEFAULT (Master: short TTL, exact minutes NEEDS DECISION)
FARE_QUOTE_TTL_SECONDS=900
# Offer TTL is a DEVELOPMENT DEFAULT (dummy 27s is not production policy; NEEDS DECISION)
OFFER_TTL_SECONDS=300

# Comma-separated browser origins. Empty still allows Flutter Chrome
# (localhost / 127.0.0.1 / 10.0.2.2, any port) when NODE_ENV is not production.
# Chrome treats http://localhost as potentially trustworthy, so the deployed
# Netlify Admin may call the local API. Do not set origin: '*'.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8888,https://idhar-udhar-admin.netlify.app
