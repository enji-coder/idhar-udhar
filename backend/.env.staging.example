# IDHAR UDHAR API — STAGING template (placeholders only).
# Copy to a private staging secret store or local backend/.env.staging (gitignored).
# NEVER commit real values. NEVER paste production Secrets Manager values here.
#
# Isolation rules:
# 1. IU_DEPLOYMENT_TIER=staging is required so the API refuses production Cashfree hosts.
# 2. CASHFREE_ENVIRONMENT must remain sandbox.
# 3. DATABASE_* must point at a staging-only PostgreSQL instance — never production RDS.
# 4. Use a staging-only Secrets Manager secret (e.g. idhar-udhar/staging/backend), not .../prod/...
# 5. Do not reuse production JWT peppers, OTP peppers, or Cashfree client secrets.

IU_DEPLOYMENT_TIER=staging
NODE_ENV=production
PORT=3000

# --- Staging PostgreSQL (isolated instance or isolated database name) ---
DATABASE_HOST=<STAGING_RDS_HOST>
DATABASE_PORT=5432
DATABASE_NAME=<STAGING_DB_NAME>
DATABASE_USER=<STAGING_DB_USER>
DATABASE_PASSWORD=<STAGING_DB_PASSWORD>
DATABASE_SSL=true
DATABASE_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem
DATABASE_POOL_MAX=10

# --- Auth (staging-only secrets; min 32 chars for JWT_ACCESS_SECRET) ---
JWT_ACCESS_SECRET=<STAGING_JWT_ACCESS_SECRET_MIN_32>
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=idhar-udhar-api-staging
REFRESH_TOKEN_PEPPER=<STAGING_REFRESH_TOKEN_PEPPER>
JWT_REFRESH_TTL_SECONDS=2592000
OTP_HASH_PEPPER=<STAGING_OTP_HASH_PEPPER>
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=20
# SMS OTP is optional and stays unconfigured until a staging MSG91 account exists.
# NODE_ENV=production blocks the capture provider. Do not set OTP_DELIVERY_PROVIDER
# until MSG91_AUTHKEY, MSG91_TEMPLATE_ID, and MSG91_SENDER_ID are real staging values.
# OTP_DELIVERY_PROVIDER=msg91
# MSG91_AUTHKEY=<STAGING_MSG91_AUTHKEY>
# MSG91_TEMPLATE_ID=<STAGING_MSG91_TEMPLATE_ID>
# MSG91_SENDER_ID=<STAGING_MSG91_SENDER_ID>
MSG91_TIMEOUT_MS=10000
DEV_OTP_PEEK=false

# --- Push ---
# FCM is optional and stays unconfigured until a staging Firebase service account exists.
# Do not set PUSH_PROVIDER until FIREBASE_SERVICE_ACCOUNT_JSON is that account JSON.
# PUSH_PROVIDER=fcm
# FIREBASE_SERVICE_ACCOUNT_JSON=<STAGING_FIREBASE_SERVICE_ACCOUNT_JSON>
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=2

# --- Routing ---
# Required at startup because NODE_ENV=production selects Google routing.
# The ECS task injects GOOGLE_MAPS_API_KEY from Secrets Manager. This line is a placeholder name, not a key.
ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=<STAGING_GOOGLE_MAPS_API_KEY>
ROUTING_TIMEOUT_MS=10000

# --- Cashfree SANDBOX only ---
PAYMENT_PROVIDER=cashfree
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=<CASHFREE_SANDBOX_CLIENT_ID>
CASHFREE_CLIENT_SECRET=<CASHFREE_SANDBOX_CLIENT_SECRET>
CASHFREE_API_VERSION=2025-01-01
CASHFREE_TIMEOUT_MS=10000
# Cashfree Payouts are optional and stay unconfigured until sandbox payout credentials exist.
# Leave both empty. Do not add them to the task definition until the values are real.
# CASHFREE_ENVIRONMENT must remain sandbox while IU_DEPLOYMENT_TIER=staging.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_API_VERSION=2024-01-01
# Required when PAYMENT_PROVIDER=cashfree. Base64 of exactly 32 random bytes.
# The ECS task injects this from Secrets Manager. Do not commit a real key.
# enc1 ciphertext has no key id. To rotate, deploy a reader that tries the new
# key and then the old key, rewrite rider_upis.vpa_encrypted_or_token and
# rider_bank_accounts.account_encrypted_or_token, then remove the old key.
# A missing or wrong key must not be treated as plaintext.
PAYOUT_INSTRUMENT_KEY=<BASE64_32_BYTE_PAYOUT_INSTRUMENT_KEY>
PAYOUT_RECONCILE_WORKER_ENABLED=false
PAYOUT_RECONCILE_POLL_MS=30000
PAYOUT_RECONCILE_MIN_AGE_SECONDS=60
PAYOUT_RECONCILE_BATCH_SIZE=20

# --- Location: temporary single-task smoke test ---
# GPS stays in this process and is lost on restart. Run exactly one ECS task.
# Do not use this configuration to validate multi-task rider dispatch or durable live tracking.
LOCATION_STORE=memory
REDIS_ENABLED=false
# Return to Redis-backed staging later by setting LOCATION_STORE=redis,
# REDIS_ENABLED=true, and REDIS_TLS=true, then supplying REDIS_HOST from
# Secrets Manager before raising the task count above 1.
# REDIS_HOST=<STAGING_REDIS_HOST>
# REDIS_PORT=6379
# REDIS_TLS=true

# --- Documents bucket (staging bucket only; never production bucket name) ---
S3_DOCUMENTS_BUCKET=<STAGING_DOCUMENTS_BUCKET>
AWS_REGION=ap-south-1
S3_SIGNED_URL_TTL_SECONDS=300

FARE_QUOTE_TTL_SECONDS=900
OFFER_TTL_SECONDS=30

# One exact staging admin origin. NODE_ENV=production allows only origins listed here.
# Replace <STAGING_ADMIN_HOST> with that host. Do not use * or a list of unreviewed origins.
CORS_ORIGIN=https://<STAGING_ADMIN_HOST>

# Webhook URLs to register in Cashfree Sandbox dashboard (not env vars; listed for operators):
#   https://<STAGING_API_HOST>/v1/payments/cashfree/webhook
#   https://<STAGING_API_HOST>/v1/payments/cashfree/payout-webhook
