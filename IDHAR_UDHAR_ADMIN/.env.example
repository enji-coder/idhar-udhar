# Local Admin talks only to NestJS. Vite exposes VITE_* to the browser.
# Never put DATABASE_*, JWT secrets, or admin passwords in this file.
# Staging Admin: copy .env.staging.example and set VITE_API_BASE_URL to the
# staging API host only (never mix Sandbox payment tests with production API).
VITE_API_BASE_URL=https://api.idharudhar.co.in
