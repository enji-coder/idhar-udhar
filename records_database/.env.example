# Local PostgreSQL connection names only. Copy to records_database/.env
# NEVER commit real passwords.

# local = docker exec into idhar_udhar_postgres (default if unset)
# external = host psql to DATABASE_HOST (AWS RDS or any remote PostgreSQL)
DATABASE_MODE=local

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=idhar_udhar
DATABASE_USER=idhar_admin
DATABASE_PASSWORD=
DATABASE_SSL=false

# Required when DATABASE_MODE=external and DATABASE_SSL=true (for example Amazon RDS CA bundle).
# DATABASE_SSL_ROOT_CERT=C:\path\to\rds-ca-bundle.pem
